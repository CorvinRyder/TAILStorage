<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard Checker v2.0" 
        Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Dark Color Palette -->
        <SolidColorBrush x:Key="BgBrush" Color="#1E1E22" />
        <SolidColorBrush x:Key="PanelBrush" Color="#25252A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#33333B" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8E8E9A" />
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC" />

        <!-- Simple Custom Scrollbar Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D35"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#383845"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Outer Border -->
    <Border Background="{StaticResource BgBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="10">

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="361*"/>
                <ColumnDefinition Width="505*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="59.28"/>
                <!-- Search Bar -->
                <RowDefinition/>
                <!-- Split View (List + Preview) -->
                <RowDefinition Height="15"/>
                <!-- Footer / Shortcuts -->
            </Grid.RowDefinitions>

            <!-- 1. TOP SEARCH BAR -->
            <Border Grid.Row="0" 
                    Background="{StaticResource PanelBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12,10" 
                    Margin="0,0,0,16" Grid.ColumnSpan="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />

                    <TextBox Grid.Column="1" 
                             
                             Text="Search titles or content..." 
                             Foreground="{StaticResource TextSecondary}"
                             Background="Transparent" 
                             BorderThickness="0" 
                             FontSize="15" 
                             VerticalAlignment="Center"/>

                    <Border Grid.Column="2" Background="#2D2D35" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Ctrl + Space" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. SPLIT VIEW MAIN CONTENT -->
            <Grid Margin="0,59,0,16" Grid.ColumnSpan="2" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="361"/>
                    <!-- Left: History List -->
                    <ColumnDefinition Width="11"/>
                    <!-- Spacer -->
                    <ColumnDefinition/>
                    <!-- Right: Preview Pane -->
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: History List -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" 
                               Text="RECENT HISTORY" 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Margin="4,0,0,8"/>

                    <ListBox x:Name="RecordList1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="RecordList1_SelectionChanged" />
                </DockPanel>

                <!-- RIGHT PANE: Detail Preview Inspector -->
                <Border Grid.Column="2" 
                        Background="{StaticResource PanelBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Metadata Header -->
                        <TextBlock x:Name="lbl_srcwindow" Grid.Row="0" Text="Source: Visual Studio 2022" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Row="1" Text="Process: devenv.exe | CRC32: 0x8A4F12C3" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,12"/>

                        <!-- Code Preview Box -->
                        <Border Grid.Row="2" Background="#18181C" CornerRadius="6" Padding="12">
                            <ScrollViewer x:Name="view_scroll" VerticalScrollBarVisibility="Auto" >
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#ABB2BF" TextWrapping="Wrap">
                                    Test
                                </TextBlock>
                            </ScrollViewer>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Paste to App" Background="{StaticResource AccentColor}" Foreground="White" Padding="12,6" Margin="0,0,8,0" BorderThickness="0"/>
                            <Button Content="Delete" Background="#3A2D2D" Foreground="#E06C75" Padding="12,6" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. FOOTER LEGEND -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3,0,-3">
                <TextBlock Text="💡" Foreground="White" Margin="0,0,6,0"/>
                <TextBlock Text="↑↓ Navigate  |  ↵ Paste  |  Ctrl+D Delete  |  Esc Close" 
                            Foreground="{StaticResource TextSecondary}" 
                            FontSize="11" 
                            VerticalAlignment="Center"/>
            </StackPanel>
            
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Grid.ColumnSpan="2" Margin="0,215,0,-9">
                <UIElement.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </UIElement.RenderTransform>
            </Border>
        </Grid>
    </Border>
</Window>